  "chapter": "ssc-higher-math-chapter-02-model-test-03",
  "text": "যদি $x+y=13$ এবং $xy=36$ হয়, তবে $x^2+y^2$ এর মান কত?",
  "options": ["97", "100", "109", "121"],
  "answer": "97",
  "answerIndex": 0,
  "explanation": "$x^2+y^2=(x+y)^2-2xy=13^2-2\times36=169-72=97$।",
  "image": null,
  "optionImages": null,
  "timeLimit": 60
  },
  {
