  "chapter": "ssc-higher-math-chapter-02-model-test-02",
  "text": "যদি $x+y=11$ এবং $xy=28$ হয়, তবে $x^2+y^2$ এর মান কত?",
  "options": ["49", "55", "65", "121"],
  "answer": "65",
  "answerIndex": 2,
  "explanation": "$x^2+y^2=(x+y)^2-2xy=11^2-2\times28=121-56=65$।",
  "image": null,
  "optionImages": null,
  "timeLimit": 60
