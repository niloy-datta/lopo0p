  "chapter": "ssc-higher-math-chapter-02-model-test-04",
  "text": "যদি $x+y=15$ এবং $xy=54$ হয়, তবে $x^2+y^2$ এর মান কত?",
  "options": ["108", "117", "135", "225"],
  "answer": "117",
  "answerIndex": 1,
  "explanation": "$x^2+y^2=(x+y)^2-2xy=15^2-2\times54=225-108=117$।",
  "image": null,
  "optionImages": null,
  "timeLimit": 60
  },
  {
