        {"id":"ssc-general-math-chapter-02-model-test-04-q09","text":"A = {∅} হলে n(A) কত?","options":["০","১","২","অসীম"],"answer":"১","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-04-q10","text":"∅ ও {∅} সম্পর্কে সঠিকটি কোনটি?","options":["∅ = {∅}","∅ ∈ {∅}","{∅} ⊂ ∅","n(∅) = ১"],"answer":"∅ ∈ {∅}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-04-q11","text":"A = {১, ২, ৩}, B = {২, ৩, ৪}, C = {৩, ৪, ৫} হলে A ∩ B ∩ C কোনটি?","options":["{২}","{৩}","{৪}","∅"],"answer":"{৩}","answerIndex":1},
