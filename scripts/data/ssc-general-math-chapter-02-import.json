        {"id":"ssc-general-math-chapter-02-model-test-05-q11","text":"U = {১, ২, ৩, ৪, ৫, ৬, ৭}, A = {১, ৩, ৫, ৭}, B = {২, ৩, ৫} হলে A′ ∩ B কোনটি?","options":["{২}","{৩, ৫}","{২, ৪, ৬}","{১, ৭}"],"answer":"{২}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-05-q12","text":"U = {১, ২, ৩, ৪, ৫, ৬}, A = {১, ২, ৩}, B = {৩, ৪, ৫} হলে A′ ∪ B′ কোনটি?","options":["{১, ২, ৪, ৫, ৬}","{৩}","{৬}","{১, ২, ৩, ৪, ৫}"],"answer":"{১, ২, ৪, ৫, ৬}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-05-q13","text":"U = {১, ২, ৩, ৪, ৫, ৬}, A = {১, ২, ৩}, B = {৩, ৪, ৫} হলে (A ∩ B)′ কোনটি?","options":["{৩}","{১, ২, ৪, ৫, ৬}","{৬}","{১, ২, ৩, ৪, ৫}"],"answer":"{১, ২, ৪, ৫, ৬}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q14","text":"n(A ∪ B) = ৩৫, n(A) = ২২, n(B) = ১৯ হলে n(A ∩ B) কত?","options":["৪","৬","৮","১০"],"answer":"৬","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q15","text":"৬০ জন শিক্ষার্থীর মধ্যে ৩৫ জন গণিত, ৩০ জন ইংরেজি এবং ২০ জন উভয়টি পছন্দ করে। শুধু গণিত পছন্দ করে কতজন?","options":["১৫","২০","২৫","৩০"],"answer":"১৫","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-05-q16","text":"৬০ জন শিক্ষার্থীর মধ্যে ৩৫ জন গণিত, ৩০ জন ইংরেজি এবং ২০ জন উভয়টি পছন্দ করে। কোনোটি পছন্দ করে না কতজন?","options":["১০","১৫","২০","২৫"],"answer":"১৫","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q17","text":"A = {১, ২, ৩}, B = {৪, ৫}, C = {৬} হলে n((A × B) × C) কত?","options":["৫","৬","৮","১২"],"answer":"৬","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q18","text":"A = {১, ২}, B = {৩, ৪, ৫} হলে A × B-এর উপাদানগুলোর মধ্যে প্রথম স্থানাঙ্ক ২—এমন ordered pair কয়টি?","options":["২","৩","৫","৬"],"answer":"৩","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q19","text":"(২x − ১, y + ৩) = (৭, ১০) হলে x + y কত?","options":["৯","১০","১১","১২"],"answer":"১১","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-05-q20","text":"f(x) = ২x² − ৩x + ১ হলে f(−১) কত?","options":["০","৩","৬","−৪"],"answer":"৬","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-05-q21","text":"f(x) = x² − ২x হলে f(৩) − f(১) কত?","options":["২","৪","৬","৮"],"answer":"৪","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-05-q22","text":"f(x) = ৩x − ৪ এবং f(a) = ১১ হলে a কত?","options":["৩","৪","৫","৬"],"answer":"৫","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-05-q23","text":"A = {−১, ০, ১, ২}, f(x) = ২x + ১ হলে রেঞ্জ কোনটি?","options":["{−১, ১, ৩, ৫}","{১, ৩, ৫, ৭}","{−২, ০, ২, ৪}","{০, ১, ২, ৩}"],"answer":"{−১, ১, ৩, ৫}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-05-q24","text":"A = {−২, −১, ০, ১, ২}, f(x) = x² − ১ হলে রেঞ্জ কোনটি?","options":["{−১, ০, ৩}","{০, ১, ৪}","{−৫, −২, −১, ০, ৩}","{−১, ১, ৩}"],"answer":"{−১, ০, ৩}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-05-q25","text":"A = {১, ২, ৩}, B = {৪, ৫, ৬}, নিচের কোন সম্পর্কটি A থেকে B-তে ফাংশন নয়?","options":["{(১, ৪), (২, ৫), (৩, ৬)}","{(১, ৪), (২, ৪), (৩, ৪)}","{(১, ৫), (২, ৬), (৩, ৪)}","{(১, ৪), (১, ৫), (২, ৬), (৩, ৪)}"],"answer":"{(১, ৪), (১, ৫), (২, ৬), (৩, ৪)}","answerIndex":3}
