        {"id":"ssc-general-math-chapter-02-model-test-03-q09","text":"U = {a, b, c, d}, A = {a, b}, B = {b, c} হলে (A ∩ B)′ কোনটি?","options":["{b}","{a, c, d}","{a, d}","{c, d}"],"answer":"{a, c, d}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q10","text":"A = {১, ২, ৩}, B = {৩, ৪}, C = {৪, ৫} হলে A ∩ (B ∪ C) কোনটি?","options":["{৩}","{৪}","{৩, ৪}","∅"],"answer":"{৩}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q11","text":"A = {১, ২, ৩}, B = {২, ৩, ৪}, C = {৩, ৪, ৫} হলে (A ∩ B) ∩ C কোনটি?","options":["{২}","{৩}","{২, ৩}","{৪}"],"answer":"{৩}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q12","text":"A = {১, ২}, B = {২, ৩}, C = {৩, ৪} হলে (A ∪ B) ∩ C কোনটি?","options":["{১, ২, ৩}","{৩}","{২, ৩}","∅"],"answer":"{৩}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q13","text":"A = {১, ২, ৩}, B = {৩, ৪, ৫} হলে (A − B) ∪ (B − A) কোনটি?","options":["{১, ২, ৪, ৫}","{৩}","{১, ২, ৩, ৪, ৫}","∅"],"answer":"{১, ২, ৪, ৫}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q14","text":"A = {১, ২, ৩}, B = {৩, ৪, ৫} হলে (A ∪ B) − (A ∩ B) কোনটি?","options":["{১, ২, ৪, ৫}","{৩}","{১, ২, ৩, ৪, ৫}","∅"],"answer":"{১, ২, ৪, ৫}","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q15","text":"n(A ∪ B) = ৩০, n(A ∩ B) = ৫, n(A) = ১৮ হলে n(B) কত?","options":["১২","১৭","২০","২৫"],"answer":"১৭","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q16","text":"একটি শ্রেণিতে ২৫ জন গণিত পছন্দ করে, ২০ জন বিজ্ঞান পছন্দ করে এবং ১০ জন উভয়টি পছন্দ করে। অন্তত একটি বিষয় পছন্দ করে কতজন?","options":["৩৫","৪৫","৫৫","১৫"],"answer":"৩৫","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q17","text":"৪০ জন শিক্ষার্থীর মধ্যে ১৮ জন ফুটবল, ২২ জন ক্রিকেট এবং ৮ জন উভয়ই খেলে। কোনোটি খেলে না কতজন?","options":["৮","১০","১২","১৪"],"answer":"৮","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q18","text":"A = {১, ২, ৩}, B = {a, b} হলে A × B-এর কোনটি উপাদান?","options":["(a, ১)","(১, a)","{১, a}","(১, ২)"],"answer":"(১, a)","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q19","text":"A = {১, ২}, B = {x, y, z} হলে B × A-এর কোনটি উপাদান নয়?","options":["(x, ১)","(y, ২)","(z, ১)","(১, x)"],"answer":"(১, x)","answerIndex":3},
        {"id":"ssc-general-math-chapter-02-model-test-03-q20","text":"f(x) = x² + x হলে f(৩) কত?","options":["৬","৯","১২","১৫"],"answer":"১২","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-03-q21","text":"f(x) = ২x − ৫ হলে f(৫) কত?","options":["০","৫","১০","১৫"],"answer":"৫","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q22","text":"f(x) = ১০ − ২x হলে f(৪) কত?","options":["২","৪","৬","৮"],"answer":"২","answerIndex":0},
        {"id":"ssc-general-math-chapter-02-model-test-03-q23","text":"A = {১, ২, ৩, ৪}, f(x) = x + ৩ হলে রেঞ্জ কোনটি?","options":["{১, ২, ৩, ৪}","{৩, ৪, ৫, ৬}","{৪, ৫, ৬, ৭}","{২, ৩, ৪, ৫}"],"answer":"{৪, ৫, ৬, ৭}","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-03-q24","text":"A = {−২, −১, ০, ১}, f(x) = x² হলে রেঞ্জ কোনটি?","options":["{−২, −১, ০, ১}","{০, ১, ৪}","{১, ৪}","{−৪, −১, ০, ১}"],"answer":"{০, ১, ৪}","answerIndex":1},
        {"id":"ssc-general-math-chapter-02-model-test-03-q25","text":"নিচের কোনটি ফাংশন নয়?","options":["{(১, ২), (২, ৪), (৩, ৬)}","{(১, ৫), (২, ৫), (৩, ৫)}","{(১, ২), (১, ৪), (২, ৬)}","{(০, ১), (১, ২), (২, ৩)}"],"answer":"{(১, ২), (১, ৪), (২, ৬)}","answerIndex":2}
