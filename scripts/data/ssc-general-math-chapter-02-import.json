        {"id":"ssc-general-math-chapter-02-model-test-04-q20","text":"(x, ৩) = (৫, y) হলে x + y কত?","options":["৩","৫","৮","১৫"],"answer":"৮","answerIndex":2},
        {"id":"ssc-general-math-chapter-02-model-test-04-q21","text":"(x + ১, ৪) = (৩, y − ২) হলে x ও y যথাক্রমে—","options":["২, ৬","৩, ৪","১, ৬","২, ২"],"answer":"২, ৬","answerIndex":0},
